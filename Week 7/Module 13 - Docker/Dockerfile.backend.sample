# Sample Dockerfile for any Spring Boot service you built in
# Week 2-4 (e.g. CountryRESTService or one of the Microservices modules).
# Copy this next to that project's pom.xml and rename to "Dockerfile",
# adjusting the JAR name to match your project's artifactId/version.

# --- Stage 1: build with Maven ---
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn dependency:go-offline -B
COPY src ./src
RUN mvn clean package -DskipTests

# --- Stage 2: run with a slim JRE ---
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
# Replace with your actual built jar name from target/
COPY --from=build /app/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
